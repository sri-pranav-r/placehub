# Copy to client/.env and fill in. All four are required for `npm run build`.

VITE_SITE_NAME=PlaceHub
# Your custom domain, with https (not localhost or a *.vercel.app / *.onrender.com style address)
VITE_SITE_URL=
# Who runs the site, e.g. the college placement office. Shown in the privacy policy and terms.
VITE_OPERATOR_NAME=
# Address people can write to about their data or the terms
VITE_CONTACT_EMAIL=
